# Copy to .env and fill in. Every POLYBOT_ variable maps onto AppConfig
# (see src/polybot/config.py); nested fields use a double underscore, e.g.
# POLYBOT_RISK__MAX_STAKE_PER_TRADE_USD=25.
#
# Nothing below is required to run `polybot discover` or `polybot record`
# (OBSERVE mode needs no credentials at all).

# --- Storage --------------------------------------------------------------
POLYBOT_STORAGE__DATABASE_URL=postgresql+asyncpg://polybot:polybot@localhost:5432/polybot
POLYBOT_STORAGE__REDIS_URL=redis://localhost:6379/0

# --- Trading mode -----------------------------------------------------------
# observe (default, safe) | paper | shadow | live
POLYBOT_MODE=observe

# Required IN ADDITION to >=1000 recorded+evaluated markets before LIVE mode
# will actually arm (see README "Trading modes"). Setting this alone does
# nothing without that history; the app silently falls back to shadow.
# POLYBOT_LIVE_CONFIRM=I_UNDERSTAND_LIVE_TRADING_RISKS

# --- Polymarket CLOB execution (required for SHADOW/LIVE) -------------------
# POLYBOT_EXECUTION__PRIVATE_KEY=0x...
# POLYBOT_EXECUTION__API_KEY=...
# POLYBOT_EXECUTION__API_SECRET=...
# POLYBOT_EXECUTION__API_PASSPHRASE=...
# POLYBOT_EXECUTION__FUNDER_ADDRESS=0x...
# POLYBOT_EXECUTION__SIGNATURE_TYPE=0

# --- Direct Chainlink Data Streams (optional, paid) --------------------------
# Leave unset to use Polymarket's free RTDS relay (the default settlement
# source) instead. Only set these if you specifically want the direct feed.
# POLYBOT_FEEDS__CHAINLINK_STREAMS_API_KEY=...
# POLYBOT_FEEDS__CHAINLINK_STREAMS_API_SECRET=...

# --- Geographic eligibility gate (required for any order submission) --------
# POLYBOT_RISK__GEO_ELIGIBLE=true
# POLYBOT_RISK__GEO_ATTESTATION="I have confirmed I am permitted to trade on Polymarket from my jurisdiction"

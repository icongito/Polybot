{
  "name": "point-made-reel",
  "version": "1.0.0",
  "private": true,
  "description": "A 15-second motion design reel rendered in WebGL2: point, line, plane, volume, time.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "preview": "node tools/render.mjs --scale 0.5 --sub 1 --preset veryfast --crf 20 --out out/preview.mp4",
    "render": "node tools/render.mjs --scale 1 --sub 6 --subWorld 2 --out out/point-made.mp4"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
